{
  "name": "@tracewayapp/jquery",
  "version": "2.1.0",
  "description": "Traceway jQuery integration with automatic AJAX error capture and distributed tracing",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/traceway-jquery.iife.global.js",
  "jsdelivr": "./dist/traceway-jquery.iife.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@tracewayapp/core": "2.1.0",
    "@tracewayapp/frontend": "2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tracewayapp/js-client.git",
    "directory": "packages/jquery"
  }
}
