{
  "name": "traceway-js",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/opamp",
    "packages/frontend",
    "packages/react",
    "packages/react-native",
    "packages/vue",
    "packages/svelte",
    "packages/jquery",
    "packages/sourcemap-upload",
    "packages/bundler-plugin"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-bundle-size.mjs",
    "test:browser": "npm run build --workspace @tracewayapp/core && npm run build --workspace @tracewayapp/opamp && npm run build --workspace @tracewayapp/frontend && node scripts/browser-regressions.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:live": "npm run build && node scripts/browser-live.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "svelte": "^4.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vue": "^3.4.0",
    "esbuild": "^0.27.7"
  }
}
